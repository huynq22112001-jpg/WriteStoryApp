{
  "name": "writestory-app",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.16.0"
  },
  "pnpm": {
    "overrides": {
      "prosemirror-view": ">=1.41.9"
    }
  },
  "scripts": {
    "dev": "node tools/dev/start_dev.mjs",
    "dev:fe": "pnpm --filter fe dev",
    "build:fe": "pnpm --filter fe build",
    "test:fe": "pnpm --filter fe test",
    "typecheck:fe": "pnpm --filter fe typecheck",
    "gen:api": "pnpm --filter fe gen:api"
  }
}
